---
import { content, pathFor, type Locale, type PageKey } from "@lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
type NavKey = Exclude<PageKey, "home">;
const navItems: NavKey[] = ["about", "projects", "services", "contact"];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="eyebrow">{t.footer.eyebrow}</p>
      <h2>{t.footer.title}</h2>
      <p>{t.footer.body}</p>
    </div>
    <div class="footer-links">
      {navItems.map((item) => <a href={pathFor(locale, item)}>{t.nav[item]}</a>)}
      <a href={pathFor(locale, "contact")}>Barcelona, Spain</a>
    </div>
  </div>
</footer>
