---
import BaseLayout from "@layouts/BaseLayout.astro";
import { content } from "@lib/content";

const locale = "es";
const t = content[locale];
---

<BaseLayout locale={locale} page="about" title={t.about.seoTitle} description={t.about.seoDescription}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h1>{t.about.title}</h1>
      <p>{t.about.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div class="quote-panel">
        <p class="eyebrow">{t.about.profile.eyebrow}</p>
        <h2>{t.about.profile.title}</h2>
        <p>{t.about.profile.body}</p>
      </div>
      <div class="card">
        <h2>{t.about.workTitle}</h2>
        <ul class="feature-list">{t.about.workPoints.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section split-band">
    <div class="container section-header">
      <div>
        <p class="eyebrow">{t.about.experienceEyebrow}</p>
        <h2>{t.about.experienceTitle}</h2>
        <p>{t.about.experienceLead}</p>
      </div>
    </div>
    <div class="container experience-list">
      {t.about.experienceItems.map((item) => (
        <article class="experience-card">
          <div class="experience-meta">
            <p class="eyebrow">{item.period}</p>
            <h3>{item.company}</h3>
            <strong>{item.role}</strong>
          </div>
          <div>
            <p>{item.summary}</p>
            <ul class="feature-list">{item.points.map((point) => <li>{point}</li>)}</ul>
            <p class="experience-contribution">{item.contribution}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container section-header">
      <div>
        <p class="eyebrow">{t.about.problemsEyebrow}</p>
        <h2>{t.about.problemsTitle}</h2>
      </div>
    </div>
    <div class="container grid-3">
      {t.about.problems.map((problem) => (
        <article class="card">
          <h3>{problem.title}</h3>
          <p>{problem.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div class="quote-panel">
        <p class="eyebrow">{t.about.companies.eyebrow}</p>
        <h2>{t.about.companies.title}</h2>
        <p>{t.about.companies.body}</p>
      </div>
      <div class="card">
        <h3>{t.about.usefulTitle}</h3>
        <ul class="feature-list">{t.about.usefulPoints.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>
</BaseLayout>
