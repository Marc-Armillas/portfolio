---
import BaseLayout from "@layouts/BaseLayout.astro";
import CaseCard from "@components/CaseCard.astro";
import ServiceCard from "@components/ServiceCard.astro";
import { content, pathFor } from "@lib/content";

const locale = "en";
const t = content[locale];
---

<BaseLayout locale={locale} page="home" title={t.home.seoTitle} description={t.home.seoDescription}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{t.home.eyebrow}</p>
        <h1>{t.home.title}</h1>
        <p class="lead">{t.home.lead}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor(locale, "contact")}>{t.home.primaryCta}</a>
          <a class="button button-secondary" href={pathFor(locale, "projects")}>{t.home.secondaryCta}</a>
        </div>
      </div>
      <aside class="credibility-panel" aria-label={t.home.metricsLabel}>
        <div class="metric-stack">
          {t.home.metrics.map((metric) => (
            <div class="metric">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section split-band">
    <div class="container section-header">
      <div>
        <p class="eyebrow">{t.home.wordans.eyebrow}</p>
        <h2>{t.home.wordans.title}</h2>
        <p>{t.home.wordans.body}</p>
      </div>
      <a class="button button-secondary" href={pathFor(locale, "projects")}>{t.home.wordans.cta}</a>
    </div>
    <div class="container case-grid">
      {t.caseStudies.slice(0, 4).map((study) => <CaseCard study={study} />)}
    </div>
  </section>

  <section class="section">
    <div class="container section-header">
      <div>
        <p class="eyebrow">{t.services.eyebrow}</p>
        <h2>{t.services.title}</h2>
        <p>{t.services.lead}</p>
      </div>
    </div>
    <div class="container grid-3">
      {t.servicesList.map((service) => <ServiceCard service={service} limit={3} />)}
    </div>
  </section>

  <section class="section split-band">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">{t.stack.eyebrow}</p>
        <h2>{t.stack.title}</h2>
        <p class="lead">{t.stack.lead}</p>
      </div>
      <div class="stack-grid">
        {Object.entries(t.stack.groups).map(([name, items]) => (
          <div class="card">
            <h3>{name}</h3>
            <ul class="pill-list">
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container quote-panel">
      <p class="eyebrow">{t.home.conversion.eyebrow}</p>
      <h2>{t.home.conversion.title}</h2>
      <p>{t.home.conversion.body}</p>
      <div class="section-actions">
        <a class="button button-primary" href={pathFor(locale, "contact")}>{t.home.primaryCta}</a>
        <a class="button button-secondary" href={pathFor(locale, "services")}>{t.nav.services}</a>
      </div>
    </div>
  </section>
</BaseLayout>
