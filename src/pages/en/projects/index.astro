---
import BaseLayout from "@layouts/BaseLayout.astro";
import CaseCard from "@components/CaseCard.astro";
import { content } from "@lib/content";

const locale = "en";
const t = content[locale];
---

<BaseLayout locale={locale} page="projects" title={t.projects.seoTitle} description={t.projects.seoDescription}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h1>{t.projects.title}</h1>
      <p>{t.projects.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container case-grid">
      {t.caseStudies.map((study) => (
        <CaseCard
          study={study}
          detailed
          responsibilitiesLabel={t.projects.responsibilities}
          outcomeLabel={t.projects.outcome}
        />
      ))}
    </div>
  </section>
</BaseLayout>
